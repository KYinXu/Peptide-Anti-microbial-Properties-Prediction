{
  "_documentation": "Defaults for proteome_candidate_generator. Run from sequence_to_svm_minimal: python -m proteome_candidate_generator --config configs/pepsickle_pipeline.json. Repeat --config for layered overrides; CLI flags override JSON. In filtering, null top_n keeps all candidates; null min_len/max_len/min_charge/min_hydrophobicity fall back to protocol defaults (current: 8/30/2/0.30, paper_pddp: 10/50/0/0.0). paper_score_mode=amp_scoring uses the published AMP_scoring Pane implementation.",

  "command": "all",
  "input": "data/proteomes/uniprotkb_UP000005640_AND_model_organis_2026_06_27.fasta",
  "output_dir": "data/proteomes/paper_pddp_relaxed",

  "preprocessing": {
    "require_standard_aa_20": true,
    "batch_size": 1000,
    "limit_proteins": null
  },

  "pepsickle": {
    "pepsickle_bin": "pepsickle",
    "threshold": 0.6,
    "cleavage_models": [
      "constitutive",
      "immunoproteasome"
    ],
    "workers": 1,
    "resume": true,
    "force": false
  },

  "fragment_expansion": {
    "include_terminal_boundaries": true,
    "dedupe_sequences": true
  },

  "filtering": {
    "protocol": "paper_pddp",
    "min_len": 10,
    "max_len": 50,
    "min_charge": null,
    "min_hydrophobicity": null,
    "top_n": null,
    "positive_charge_residues": "RK",
    "negative_charge_residues": "DE",
    "hydrophobic_residues": "AILMFVPG",
    "hydrophobic_moment_angle_degrees": 100.0
  },

  "mapp_database": {
    "mapp_database": "data/proteomes/MAPP_database.csv",
    "amp_score_threshold": 0.0,
    "require_cationic_cterm": false,
    "cationic_cterm_residues": "KRH",
    "overlap_policy": "keep_all"
  },

  "paper_pddp": {
    "paper_score_mode": "amp_scoring",
    "pane_m_exponent": 0.9,
    "pane_n_exponent": 1.1,
    "amp_score_threshold": 5.0,
    "require_cationic_cterm": false,
    "cationic_cterm_residues": "KRH",
    "overlap_policy": "top_score_overlap_fraction_longer",
    "overlap_fraction_cutoff": 0.75
  },

  "output": {
    "output_format": "auto",
    "no_progress": false
  }
}
